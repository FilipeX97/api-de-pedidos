# POSTGRESQL LOCAL
DB_NAME=api_pedidos_homolog
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/api_pedidos_homolog
DB_USERNAME=
DB_PASSWORD=

# MONGODB OPERACIONAL
MONGO_PORT=27017
MONGO_DATABASE=api_pedidos_operacional_homolog
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTHENTICATION_DATABASE=admin

# JWT
JWT_SECRET=
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_RENEW_BEFORE_EXPIRATION=300000

# OBSERVABILIDADE
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# WEBHOOK
FAKE_WEBHOOK_SECRET=

# RABBITMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# KAFKA
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_TOPIC_PEDIDOS=api.pedidos.eventos.v1
KAFKA_CONSUMER_GROUP_INTEGRACAO=api-pedidos-integracao-v1
KAFKA_CONSUMER_GROUP_ANALYTICS=api-pedidos-analytics-v1
KAFKA_OUTBOX_INTERVAL_MS=1000
KAFKA_METRICS_INTERVAL_MS=15000
      "title": "Mensagens publicadas",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(api_pedidos_rabbitmq_mensagens_publicadas_total{job=\"api-de-pedidos\"}[1h]))",
          "legendFormat": "Publicadas"
